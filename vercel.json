{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/lemon-academy-angular/browser",
  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "https://lemonwebsite-backend.onrender.com/api/v1/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
